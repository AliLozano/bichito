{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bichito",
  "version": "0.4.4",
  "identifier": "io.creavity.bichito",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "bichito",
        "width": 440,
        "height": 560,
        "resizable": false,
        "center": true,
        "visible": true,
        "decorations": true,
        "url": "index.html"
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "resizable": false,
        "visible": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AliLozano/bichito/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5NzRBMzAwQkFDMzI4N0IKUldSN0tNTzZBS04wR1dGTFdBeVU5NDRlQ05vQk93dmZOdFROeDJZMXVYUW5JS3MyZGZUcEFSZE4K"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
